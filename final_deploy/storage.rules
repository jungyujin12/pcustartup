rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null;
    }

    function clubExists(code) {
      return firestore.exists(/databases/(default)/documents/clubs/$(code));
    }

    function validReportUpload() {
      return request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches(
          'application/pdf|image/jpeg|image/png|image/webp'
        );
    }

    match /reports/{year}/{clubCode}/{fileName} {
      allow read: if isAdmin() || clubExists(clubCode);
      allow create, update: if clubExists(clubCode) && validReportUpload();
      allow delete: if isAdmin();
    }

    match /clubs/{clubCode}/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /signs/{clubCode}/{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
